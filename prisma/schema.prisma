generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique // Identificador principal
  tickets      Ticket[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Raffle {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  totalTickets Int
  status       RaffleStatus @default(DRAFT)
  winnerTicketId String?
  winnerName     String?
  tickets      Ticket[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  FINISHED
}

model Ticket {
  id        String       @id @default(uuid())
  number    Int
  status    TicketStatus @default(AVAILABLE)
  raffle    Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  raffleId  String
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([raffleId, number]) // Garante que não haja números duplicados na mesma rifa
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  PAID
}

model Transaction {
  id         String            @id @default(uuid())
  externalId String?           @unique // ID do Mercado Pago
  amount     Decimal           @db.Decimal(10, 2)
  status     TransactionStatus @default(PENDING)
  user       User              @relation(fields: [userId], references: [id])
  userId     String
  ticketIds  String            @db.Text // JSON string to array of ticket IDs or simple comma separated
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}
